    "schemaVersion": 2,
    "states": ["booting", "syncing", "ready", "degraded", "unhealthy"],
    "readyRequires": [
      "matching-cosmos-chain-id",
      "matching-reachable-node-identities",
      "commit-quorum-ready",
      "matching-evm-chain-id",
      "evm-not-syncing",
      "positive-consensus-and-evm-heights",
      "version-visible"
    ],
    "reports": [
      "application-version",
      "comet-version",
      "cosmos-chain-id",
      "evm-chain-id",
      "peer-count",
      "sync-state",
      "consensus-height",
