{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torium.network/schemas/sdk-policy-v0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyVersion",
    "status",
    "package",
    "baseline",
    "runtimes",
    "modules",
    "publicApi",
    "accounts",
    "failures",
    "compatibility",
    "budgets",
    "forbiddenCoreDependencies",
    "consumerIssues"
  ],
  "properties": {
    "$schema": { "const": "./sdk-policy-v0.schema.json" },
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "0.1.0" },
    "status": { "const": "v0-published" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourcePath",
        "publishAccess",
        "reservationStatus",
        "privateUntilApproved"
      ],
      "properties": {
        "name": { "const": "@torium-network/sdk" },
        "sourcePath": { "const": "packages/torium-sdk" },
        "publishAccess": { "const": "public" },
        "reservationStatus": { "const": "organization-created" },
        "privateUntilApproved": { "const": false }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viem", "typescript"],
      "properties": {
        "viem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["testedVersion", "peerRange", "checkedAt"],
          "properties": {
            "testedVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "peerRange": { "const": ">=2.55.2 <3" },
            "checkedAt": { "type": "string", "format": "date" }
          }
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buildVersion", "consumerRange"],
          "properties": {
            "buildVersion": { "const": "5.9.3" },
            "consumerRange": { "const": ">=5.7 <7" }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "browser", "reactNative"],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "range",
            "canonicalTestVersion",
            "candidateLtsMajors",
            "supportStatus"
          ],
          "properties": {
            "range": { "const": ">=22.23.1 <23 || >=24 <25" },
            "canonicalTestVersion": { "const": "22.23.1" },
            "candidateLtsMajors": { "const": [22, 24] },
            "supportStatus": {
              "const": "ci-esm-cjs-verified-issue-136"
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements",
            "candidateTestEngines",
            "resolvedVersionsRecordedByIssue",
            "supportStatus"
          ],
          "properties": {
            "requirements": {
              "const": [
                "ES2022",
                "BigInt",
                "fetch",
                "EIP-1193-when-wallet-signing"
              ]
            },
            "candidateTestEngines": {
              "const": ["chromium", "firefox", "webkit"]
            },
            "resolvedVersionsRecordedByIssue": { "const": 136 },
            "supportStatus": {
              "const": "vite-bundle-and-eip1193-mock-verified-issue-136"
            }
          }
        },
        "reactNative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumVersion",
            "engine",
            "nodePolyfillsAllowed",
            "supportStatus"
          ],
          "properties": {
            "minimumVersion": { "const": "0.81.0" },
            "engine": { "const": "Hermes" },
            "nodePolyfillsAllowed": { "const": false },
            "supportStatus": {
              "const": "metro-hermes-bytecode-verified-issue-136"
            }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "types",
        "sideEffects",
        "treeShakingRequired",
        "exports",
        "experimentalExport",
        "generatedPath",
        "generatedFilesEditable"
      ],
      "properties": {
        "format": { "const": "dual-esm-cjs" },
        "types": { "const": "declarations" },
        "sideEffects": { "const": false },
        "treeShakingRequired": { "const": true },
        "exports": {
          "const": [
            ".",
            "./chains",
            "./clients",
            "./wallet",
            "./contracts",
            "./errors",
            "./utils",
            "./experimental"
          ]
        },
        "experimentalExport": { "const": "./experimental" },
        "generatedPath": { "const": "src/generated" },
        "generatedFilesEditable": { "const": false }
      }
    },
    "publicApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transportPolicy",
        "proprietaryTransportAllowed",
        "defaultPublicRpcAllowed",
        "localLoopbackDefaultsAllowed",
        "clientFactories",
        "boundaries"
      ],
      "properties": {
        "transportPolicy": { "const": "accept-standard-viem-and-eip1193" },
        "proprietaryTransportAllowed": { "const": false },
        "defaultPublicRpcAllowed": { "const": false },
        "localLoopbackDefaultsAllowed": { "const": true },
        "clientFactories": {
          "const": ["createToriumPublicClient", "createToriumWalletClient"]
        },
        "boundaries": {
          "const": [
            "chains",
            "clients",
            "wallet",
            "contracts",
            "errors",
            "amount-and-address-utils"
          ]
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rawSecretMaterialAcceptedAtAnyApiLevel",
        "rawSecretMaterial",
        "keyGenerationAllowed",
        "keyPersistenceAllowed",
        "secretLoggingAllowed",
        "signingOwner"
      ],
      "properties": {
        "accepted": {
          "const": [
            "viem-Account",
            "EIP-1193-provider",
            "caller-supplied-wallet-client"
          ]
        },
        "rawSecretMaterialAcceptedAtAnyApiLevel": { "const": false },
        "rawSecretMaterial": {
          "const": ["private-key", "mnemonic", "seed", "keystore", "key-bytes"]
        },
        "keyGenerationAllowed": { "const": false },
        "keyPersistenceAllowed": { "const": false },
        "secretLoggingAllowed": { "const": false },
        "signingOwner": { "const": "caller-wallet-or-explicit-viem-account" }
      }
    },
    "failures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomyVersion",
        "normalizedBoundaries",
        "directViemActions",
        "defaultAttempts",
        "maximumIdempotentReadAttempts",
        "automaticRetryOperations",
        "safeBroadcastRetryConditions",
        "broadcastMaxAttempts",
        "globalTimeoutOwner",
        "sdkActionsSupportAbortSignal",
        "sdkActionsSupportPerActionTimeout",
        "diagnostics",
        "diagnosticCauseIncluded"
      ],
      "properties": {
        "taxonomyVersion": { "const": 1 },
        "normalizedBoundaries": {
          "const": [
            "endpoint-validation",
            "torium-client-actions",
            "torium-wallet-actions"
          ]
        },
        "directViemActions": { "const": "preserve-viem-errors" },
        "defaultAttempts": { "const": 1 },
        "maximumIdempotentReadAttempts": { "const": 3 },
        "automaticRetryOperations": {
          "const": ["idempotent-read-explicit-opt-in"]
        },
        "safeBroadcastRetryConditions": { "const": [] },
        "broadcastMaxAttempts": { "const": 1 },
        "globalTimeoutOwner": { "const": "caller-viem-transport" },
        "sdkActionsSupportAbortSignal": { "const": true },
        "sdkActionsSupportPerActionTimeout": { "const": true },
        "diagnostics": { "const": "opt-in-allowlist" },
        "diagnosticCauseIncluded": { "const": false }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semverBefore1",
        "semverAfter1",
        "v0SupportWindow",
        "stableSupportWindow",
        "chainManifest",
        "contractIdentity",
        "unknownCompatibilityBehavior",
        "testGates"
      ],
      "properties": {
        "semverBefore1": { "$ref": "#/$defs/semverBefore1" },
        "semverAfter1": { "$ref": "#/$defs/semverAfter1" },
        "v0SupportWindow": { "const": "latest-minor-only" },
        "stableSupportWindow": {
          "const": "current-major-and-previous-major-for-six-months"
        },
        "chainManifest": { "const": "exact-manifest-version-and-chain-id" },
        "contractIdentity": {
          "const": "environment-address-version-runtime-hash"
        },
        "unknownCompatibilityBehavior": { "const": "fail-closed" },
        "testGates": { "$ref": "#/$defs/testGates" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootEntryGzipBytesExcludingViem",
        "packedTarballBytes",
        "browserExampleJavaScriptBytes",
        "browserExampleGzipBytes",
        "reactNativeHermesBytecodeBytes",
        "reactNativeSourceModules",
        "generatedAbiExcludedFromRootEntry"
      ],
      "properties": {
        "rootEntryGzipBytesExcludingViem": { "type": "integer", "minimum": 1 },
        "packedTarballBytes": { "type": "integer", "minimum": 1 },
        "browserExampleJavaScriptBytes": { "type": "integer", "minimum": 1 },
        "browserExampleGzipBytes": { "type": "integer", "minimum": 1 },
        "reactNativeHermesBytecodeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "reactNativeSourceModules": { "type": "integer", "minimum": 1 },
        "generatedAbiExcludedFromRootEntry": { "const": true }
      }
    },
    "forbiddenCoreDependencies": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumerIssues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  },
  "$defs": {
    "semverBefore1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "experimental"],
      "properties": {
        "patch": { "const": "backward-compatible-fixes-only" },
        "minor": {
          "const": "stable-export-breaking-change-only-with-migration-note"
        },
        "experimental": { "const": "may-change-in-minor-with-changelog" }
      }
    },
    "semverAfter1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breaking",
        "deprecationMinimumDays",
        "deprecationMinimumMinorReleases"
      ],
      "properties": {
        "breaking": { "const": "major-only" },
        "deprecationMinimumDays": { "const": 90 },
        "deprecationMinimumMinorReleases": { "const": 1 }
      }
    },
    "testGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainSource",
        "contractRegistryPattern",
        "apiSnapshotPattern",
        "implementationOwnerIssue",
        "runtimeMatrixOwnerIssue",
        "releaseComparisonOwnerIssue"
      ],
      "properties": {
        "chainSource": { "const": "chain/config/identifiers.json" },
        "contractRegistryPattern": {
          "const": "contracts/deployments/<environment>.json"
        },
        "apiSnapshotPattern": {
          "const": "packages/torium-sdk/api/<version>.api.md"
        },
        "implementationOwnerIssue": { "const": 129 },
        "runtimeMatrixOwnerIssue": { "const": 136 },
        "releaseComparisonOwnerIssue": { "const": 137 }
      }
    }
  }
}
