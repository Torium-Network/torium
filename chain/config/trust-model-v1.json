  "validatorLifecycle": {
    "localRatification": {
      "issue": 100,
      "protocolVersion": "1.0.0-local.5",
      "publicActivationAllowed": false,
      "publicActivationGateIssue": 127
    },
    "bootstrap": {
      "localnet": "four deterministic genesis validators with equal voting power",
      "allocationOwnerIssue": 91,
      "privateDevnet": "four authority validators on separate hosts before activation",
      "publicTestnet": "minimum seven independently operated validators after every readiness gate passes"
    },
    "admission": {
      "mechanism": "x/staking MsgCreateValidator plus self-delegation and bonded-set ranking",
      "offChainAllowlistAllowed": false,
      "silentGenesisFileMutationAllowed": false,
      "independentOperatorPath": "publish requirements, create operator and consensus keys independently, submit on-chain validator transaction, and enter the bonded set only through protocol state"
    },
    "removal": {
      "mechanisms": [
        "voluntary unbonding",
        "falling below the bonded-set voting-power rank",
        "downtime jailing",
        "equivocation slashing and tombstoning",
        "versioned governance parameter change"
      ],
      "offChainDeletionAllowed": false,
      "fundSeizureAllowed": false
    },
    "states": [
      {
        "id": "candidate",
        "meaning": "validator record exists but is not in the active bonded set"
      },
      {
        "id": "bonded",
        "meaning": "active validator proposes and votes; stake is slashable"
      },
      {
        "id": "unbonding",
        "meaning": "exiting stake remains slashable for infractions during the evidence window"
      },
      {
        "id": "unbonded",
        "meaning": "not active and no longer earns validator rewards"
      },
      {
        "id": "jailed-downtime",
        "meaning": "temporarily removed after missed-signature threshold; may unjail only after the jail duration"
      },
      {
        "id": "tombstoned",
        "meaning": "permanently barred from unjailing after attributable consensus equivocation"
      }
    ],
    "evidence": {
      "duplicateVote": "CometBFT verifies and commits evidence; Cosmos x/evidence and x/slashing apply the configured penalty and tombstone",
      "lightClientAttack": "CometBFT may report Byzantine validators; detection is best-effort after the less-than-one-third assumption fails",
      "downtime": "x/slashing tracks missed signatures in a window, then slashes and temporarily jails without tombstoning",
      "maxEvidenceAgeMustNotExceedUnbondingPeriod": true,
      "lightClientTrustingPeriodMustBeLessThanUnbondingPeriod": true,
      "automaticForkRepairPromised": false
    },
