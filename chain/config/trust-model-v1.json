  "finalityContract": {
    "commitMeaning": "strictly-more-than-two-thirds precommit voting power for a block under the current validator set",
    "sdkDefaultConfirmationBlocks": 1,
    "jsonRpcFinalizedTag": "latest-committed-cometbft-state",
    "jsonRpcSafeStateQueries": "unsupported-until-conformance-proves-otherwise",
    "explorerLabel": "CometBFT committed",
    "ethereumBeaconFinalityClaimAllowed": false,
    "probabilisticConfirmationClaimAllowed": false,
    "boundedTransactionInclusionClaimAllowed": false,
    "sameHeightConflictingCommitExpectedUnderAssumptions": false,
    "clientTrustRequirements": [
      "pin Cosmos chain ID and EIP-155 chain ID",
      "pin or verify genesis hash for non-local networks",
      "use trusted height and hash for state sync or light-client verification",
      "treat replacement genesis or unsafe restore as a network discontinuity"
    ]
  },
