{
  "$schema": "./secret-policy.schema.json",
  "schemaVersion": 1,
  "policyVersion": "1.0.0",
  "status": "active-local-chain-guard",
  "scope": {
    "trackedRoots": [
      "chain",
      "contracts",
      "packages/torium-sdk",
      "apps/developer-docs",
      "examples/torium",
      "docs",
      ".github/workflows"
    ],
    "trackedFiles": [".github/CODEOWNERS", "package.json", "pnpm-lock.yaml"],
    "explicitPathMode": "scan-recursively-before-packaging-or-publishing",
    "outOfScopeLegacyProductPaths": []
  },
  "limits": {
    "maximumFileBytes": 26214400,
    "oversizedFileBehavior": "fail-closed",
    "symlinkBehavior": "fail-closed",
    "archiveBehavior": "fail-and-scan-extracted-staging-directory-before-packaging"
  },
  "ignoredDirectoryNamesForExplicitPathMode": [],
  "forbiddenFileNames": [
    "priv_validator_key.json",
    "priv_validator_state.json",
    "node_key.json",
    "client.p12",
    "keystore.json"
  ],
  "forbiddenFileExtensions": [".key", ".jks", ".p12", ".pfx", ".pem"],
  "environmentFilePolicy": {
    "forbidRuntimeEnvironmentFiles": true,
    "allowedExampleSuffixes": [".env.example", ".env.production.example"]
  },
  "archiveExtensions": [".gz", ".tar", ".tar.gz", ".tgz", ".zip"],
  "allowedPlaceholderValues": [
    "<redacted>",
    "<required>",
    "REDACTED",
    "blockscout-poc-only",
    "deferred-unpublished",
    "example-only",
    "not-configured",
    "process.env",
    "${"
  ],
  "rules": [
    {
      "id": "pem-private-key",
      "severity": "critical",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "aws-access-key-id",
      "severity": "critical",
      "pattern": "AKIA[0-9A-Z]{16}",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "github-token",
      "severity": "critical",
      "pattern": "gh[pousr]_[A-Za-z0-9_]{20,}",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "npm-access-token",
      "severity": "critical",
      "pattern": "npm_[A-Za-z0-9]{36,}",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "slack-token",
      "severity": "critical",
      "pattern": "xox[baprs]-[A-Za-z0-9-]{16,}",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "openai-style-token",
      "severity": "high",
      "pattern": "\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9]{40,}\\b",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "jwt-bearer-token",
      "severity": "high",
      "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "flags": "g",
      "captureGroup": 0
    },
    {
      "id": "hex-private-key-assignment",
      "severity": "critical",
      "pattern": "(?:private[_-]?key|secret[_-]?key)[\\s\\\"']*[:=][\\s\\\"']*(0x[0-9a-fA-F]{64})",
      "flags": "gi",
      "captureGroup": 1
    },
    {
      "id": "mnemonic-assignment",
      "severity": "critical",
      "pattern": "(?:mnemonic|seed[_ -]?phrase)[\\s\\\"']*[:=][\\s\\\"']*([a-z]+(?:[ \\t]+[a-z]+){11,23})",
      "flags": "gi",
      "captureGroup": 1
    },
    {
      "id": "generic-secret-json-value",
      "severity": "high",
      "pattern": "\\\"(?:api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|password|mnemonic|token)\\\"[ \\t]*:[ \\t]*\\\"([^\\\"\\r\\n]{8,})\\\"",
      "flags": "gi",
      "captureGroup": 1
    },
    {
      "id": "credential-environment-assignment",
      "severity": "high",
      "pattern": "(?:^|\\n)(?:[A-Z0-9_]*(?:SECRET|PASSWORD|PRIVATE_KEY|API_KEY|ACCESS_KEY|TOKEN)[A-Z0-9_]*)[ \\t]*=[ \\t]*([^\\r\\n#]{8,})",
      "flags": "g",
      "captureGroup": 1
    },
    {
      "id": "credential-connection-string",
      "severity": "critical",
      "pattern": "(?:postgres(?:ql)?|redis|rediss|amqp|amqps|mongodb(?:\\+srv)?):\\/\\/[^:\\s\\/]+:([^@\\s\\/]{4,})@",
      "flags": "gi",
      "captureGroup": 1
    },
    {
      "id": "authorization-bearer-value",
      "severity": "high",
      "pattern": "authorization[\\s\\\"']*[:=][\\s\\\"']*bearer[ \\t]+([A-Za-z0-9._~+\\/=-]{20,})",
      "flags": "gi",
      "captureGroup": 1
    },
    {
      "id": "generic-secret-assignment",
      "severity": "high",
      "pattern": "(?:api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret|password|mnemonic|token)[\\s\\\"']*[:=][\\s\\\"']*([A-Za-z0-9+_\\/=.:-]{12,})",
      "flags": "gi",
      "captureGroup": 1
    }
  ],
  "allowlist": {
    "constraints": {
      "exactCountRequired": true,
      "staleEntriesFail": true,
      "contentRulesOnly": true,
      "wildcardsAllowed": false,
      "justificationRequired": true
    },
    "entries": [
