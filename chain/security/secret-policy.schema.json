{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torium.network/schemas/chain/secret-policy.schema.json",
  "title": "Torium chain prohibited-secret policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyVersion",
    "status",
    "scope",
    "limits",
    "ignoredDirectoryNamesForExplicitPathMode",
    "forbiddenFileNames",
    "forbiddenFileExtensions",
    "environmentFilePolicy",
    "archiveExtensions",
    "allowedPlaceholderValues",
    "rules",
    "requiredSurfaces",
    "findingOutput",
    "owners"
  ],
  "properties": {
    "$schema": { "const": "./secret-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "1.0.0" },
    "status": { "const": "active-local-chain-guard" },
    "scope": {
      "type": "object",
      "required": [
        "trackedRoots",
        "trackedFiles",
        "explicitPathMode",
        "outOfScopeLegacyProductPaths"
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "maximumFileBytes",
        "oversizedFileBehavior",
        "symlinkBehavior",
        "archiveBehavior"
      ]
    },
    "ignoredDirectoryNamesForExplicitPathMode": { "type": "array" },
    "forbiddenFileNames": { "type": "array", "minItems": 5 },
    "forbiddenFileExtensions": { "type": "array", "minItems": 5 },
    "environmentFilePolicy": {
      "type": "object",
      "required": ["forbidRuntimeEnvironmentFiles", "allowedExampleSuffixes"]
    },
    "archiveExtensions": { "type": "array", "minItems": 5 },
    "allowedPlaceholderValues": { "type": "array", "minItems": 8 },
    "rules": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "severity", "pattern", "flags", "captureGroup"]
      }
    },
    "requiredSurfaces": { "type": "array", "minItems": 6 },
    "findingOutput": {
      "type": "object",
      "required": [
        "includePath",
        "includeLine",
        "includeRule",
        "includeMatchedValue"
      ]
    },
    "owners": {
      "type": "object",
      "required": ["policy", "ciEnforcement", "supportBundles", "releaseGate"]
    }
  }
}
