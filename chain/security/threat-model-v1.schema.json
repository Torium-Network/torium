{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torium.network/schemas/chain/threat-model-v1.schema.json",
  "title": "Torium chain threat model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "modelVersion",
    "status",
    "updatedAt",
    "scope",
    "sources",
    "methodology",
    "assets",
    "actors",
    "boundaries",
    "risks",
    "invariants",
    "releaseGates",
    "reviewTriggers",
    "riskAcceptance"
  ],
  "properties": {
    "$schema": { "const": "./threat-model-v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "modelVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0-local\\.[1-9][0-9]*$"
    },
    "status": { "const": "local-development-security-contract" },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded", "publicDeploymentAuthorized"]
    },
    "sources": {
      "type": "object",
      "required": ["protocol", "trustModel", "secretPolicy", "upstreamSupport"]
    },
    "methodology": {
      "type": "object",
      "required": [
        "riskScore",
        "likelihoodScale",
        "impactScale",
        "severityThresholds",
        "reviewRule"
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "object", "required": ["id", "name", "properties"] }
    },
    "actors": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "object", "required": ["id", "name", "trust"] }
    },
    "boundaries": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "name", "controls", "ownerIssues"]
      }
    },
    "risks": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "assetIds",
          "actorIds",
          "boundaryIds",
          "likelihood",
          "impact",
          "severity",
          "scenario",
          "prevention",
          "detection",
          "recovery",
          "ownerIssues",
          "releaseGate",
          "mitigationStatus",
          "residualRisk",
          "reviewTriggers"
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "riskIds",
          "testTypes",
          "testIds",
          "ownerIssues"
        ]
      }
    },
    "releaseGates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "rule", "ownerIssues", "blocksPublicRelease"]
      }
    },
    "reviewTriggers": { "type": "array", "minItems": 4 },
    "riskAcceptance": {
      "type": "object",
      "required": [
        "automaticAcceptanceAllowed",
        "localDevelopmentRule",
        "publicRule",
        "acceptanceAuthorityOwnerIssue"
      ]
    }
  }
}
